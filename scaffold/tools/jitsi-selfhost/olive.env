# Olive-specific overrides for docker-jitsi-meet's env.example, applied by
# setup.sh on top of the upstream file. See README.md in this directory for
# why each of these is set (or deliberately left unset) the way it is.
#
# This file holds no secrets — gen-passwords.sh fills those into the real
# .env inside .jitsi-docker/, which is gitignored.

# Anonymous domain, deliberately. Do not set ENABLE_AUTH here — that is the
# whole point of Step 2 (see README.md "Why this exists"). If a future need
# for revocable per-call tokens (mod_auth_token / JWT) reopens this, that is
# a decision to make explicitly, not a side effect of copy-pasting a
# different docker-jitsi-meet guide.
#ENABLE_AUTH=1
#ENABLE_GUESTS=1
#AUTH_TYPE=internal

# Upstream defaults. No collision with server/index.mjs (:8080) or
# local-call-room-server.mjs (:8787).
HTTP_PORT=8000
HTTPS_PORT=8443

# Upstream default (8080) collides with server/index.mjs's own PORT default
# — found by actually bringing the stack up (docker compose ps showed
# 127.0.0.1:8080->8080/tcp on the jvb container) rather than assumed from
# reading docker-compose.yml. Remapped so both can run at once.
JVB_COLIBRI_PORT=8181

# Left commented — defaults to https://localhost:${HTTPS_PORT}, which is
# correct for this dev-only stack. Do not fill in a real domain here; that's
# a production-hosting decision this scaffold explicitly does not make (see
# README.md "What this does NOT decide").
PUBLIC_URL=https://192.168.1.175:8443

# MUST be set to the dev machine's real LAN IP before a physical device on
# the same WiFi can exchange call media (see README.md's UDP/adb-reverse
# section) — e.g. JVB_ADVERTISE_IPS=192.168.1.42
#
# Deliberately left blank rather than filled with today's IP: a hardcoded LAN
# address here is exactly the bug CHANGELOG [0.46.0] already fixed once
# (devRoomServerBase's old 192.168.1.78). Set it locally in
# .jitsi-docker/.env, which is gitignored, not here.
#JVB_ADVERTISE_IPS=

TZ=UTC
