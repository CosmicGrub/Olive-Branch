<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPLATE for the gitignored debug overlay written by generate-dev-cert.sh
  (src/debugLan/res/xml/network_security_config.xml). Same as the tracked debug config plus the
  marked Jitsi block. DEBUG BUILDS ONLY.
  Cleartext is allowed for the development server on this machine and nothing
  else: localhost, the Android emulator's host alias, and the loopback IPs.
  Everything else stays https-only. Release builds never see this file.
  A developer who wants the self-hosted Jitsi over the LAN generates a
  gitignored overlay (src/debugLan, picked up by app/build.gradle.kts) with
  tools/jitsi-selfhost/generate-dev-cert.sh; nothing LAN-specific is committed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <!-- OLIVE-LAN-JITSI-BEGIN (rewritten by tools/jitsi-selfhost/generate-dev-cert.sh; do not hand-edit)
         TEMPLATE: the address below is a documentation-range (TEST-NET-1) one, replaced by the LAN
         address(es) you pass to the generator. The ONLY extra trust is the one pinned public cert in
         res/raw, honoured for those addresses and nothing else. The base config above is untouched
         (system CAs only, no cleartext). No TrustAll anywhere. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">192.0.2.10</domain>
        <trust-anchors>
            <certificates src="@raw/jitsi_dev_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    <!-- OLIVE-LAN-JITSI-END -->
</network-security-config>
