<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY (this file lives in src/debug and overrides the main one).
  Cleartext is allowed for the development server on this machine and nothing
  else: localhost, the Android emulator's host alias, and the loopback IPs.
  Everything else stays https-only. Release builds never see this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <!-- OLIVE-LAN-JITSI-BEGIN (rewritten by tools/jitsi-selfhost/generate-dev-cert.sh; do not hand-edit)
         The owner's self-hosted Jitsi (CALL_PROVIDER=jitsi, MASTERFILE 16.2 #6). Its https endpoint
         serves a SELF-SIGNED cert. The ONLY extra trust in the whole app is this: the one pinned
         public cert in res/raw, honoured for the one LAN address below and nothing else. The base
         config above is untouched (system CAs only, no cleartext), so every other host, including
         the Olive API, keeps the platform's normal verification. No TrustAll anywhere.
         A cert that matches no listed host is useless; a new LAN IP means regenerate + rebuild. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">192.168.1.156</domain>
        <trust-anchors>
            <certificates src="@raw/jitsi_dev_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    <!-- OLIVE-LAN-JITSI-END -->
</network-security-config>
