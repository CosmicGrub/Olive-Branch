<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup and device-to-device transfer rules.

  The family, notes and journal are sealed with a key that lives in the Android
  Keystore through flutter_secure_storage (lib/store_cipher.dart). A Keystore key
  never leaves the phone, so a copy of the sealed files on another phone, or
  restored onto this one, cannot be opened: it would silently look like an empty
  install. Neither the local store nor the secure-storage preferences are
  therefore ever extracted, to the cloud or to another device.
  android:allowBackup is also false (see AndroidManifest.xml); these rules are
  the belt to that brace and cover the transfer path. The recovery path for a lost
  phone is the app's own encrypted backup, not the platform's.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter" />
        <exclude domain="file" path="olive_store" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter" />
        <exclude domain="file" path="olive_store" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
