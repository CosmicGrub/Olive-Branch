<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer: the same rule as backup_rules.xml, for cloud backup and for device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/olive_outbox"/>
        <exclude domain="root" path="app_flutter/olive_store"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/olive_outbox"/>
        <exclude domain="root" path="app_flutter/olive_store"/>
    </device-transfer>
</data-extraction-rules>
