<?xml version="1.0" encoding="utf-8"?>
<!-- LOCAL DEV/TEST ONLY. scaffold/tools/local-call-room-server.mjs serves
     plain HTTP so two physical devices can agree on a Jitsi room name (see
     call_screen.dart). Android blocks cleartext traffic by default from API
     28+; this scopes the exception instead of allowing cleartext
     everywhere. Remove once the room-coordination endpoint moves behind the
     real HTTPS API.

     127.0.0.1, not a LAN IP: call_screen.dart reaches the dev machine via
     `adb reverse tcp:8787 tcp:8787` per device (see that file's own header
     for why) rather than a hardcoded LAN address, which goes stale the
     moment the dev machine's network changes. Loopback traffic isn't
     actually gated by Android's cleartext policy in practice, but this
     entry is kept so the config states the real address in use rather than
     a dead one — a previous version of this file listed 192.168.1.78, a
     LAN IP from a network this project is no longer on, which is exactly
     the kind of drift this comment exists to prevent from happening again.

     The trust-anchor below is a second, separate concern from the
     cleartext exception above: it's for the §16.2 #6 Step 2 self-hosted
     Jitsi stack (scaffold/tools/jitsi-selfhost/), which serves real HTTPS
     with a self-signed dev cert — no public CA will ever vouch for a
     localhost-only cert, and without this the SDK's TLS handshake to that
     stack fails outright (confirmed in-browser: net::ERR_CERT_AUTHORITY_
     INVALID) regardless of how the app is configured. @raw/jitsi_dev_cert
     is generated by tools/jitsi-selfhost/generate-dev-cert.sh, which keeps
     this file's SAN scope and the actual served cert in lockstep — if you
     regenerate that cert (e.g. to add a LAN IP for WiFi-based device
     testing per that script's own header), the copy in res/raw/ updates
     automatically, but the app must be rebuilt for a device to pick it up;
     the old cert baked into an already-installed APK does not update
     itself. `system` is included alongside it so this scope doesn't
     accidentally become the ONLY thing 127.0.0.1 traffic can trust if
     something else on this address ever needs normal CA-issued TLS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="@raw/jitsi_dev_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    <!-- LAN IP for real two-device WiFi testing against the self-hosted
         Jitsi stack (§16.2 #6 Step 2) — see this file's own header above:
         adb reverse can't tunnel JVB's UDP media path, so a physical device
         must reach the dev machine's real LAN address for a call's actual
         media, not just the loopback used for room-coordination HTTP.
         generate-dev-cert.sh's own header already warns this address goes
         stale the moment the dev machine's network changes — same caution
         that entry above is about — so treat this as today's LAN IP, not a
         permanent fixture; regenerate the cert and update this address
         together if the dev machine's network changes.
         No cleartextTrafficPermitted here: nothing on this address ever
         speaks plain HTTP, only the self-hosted stack's real HTTPS. -->
    <domain-config>
        <domain includeSubdomains="false">192.168.1.175</domain>
        <trust-anchors>
            <certificates src="@raw/jitsi_dev_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
