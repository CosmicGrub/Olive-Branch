# OLIVE BRANCH — local overrides for docker-compose.dev.yml.
#
# Copy this file to .env (untracked — see the repo root .gitignore) and
# fill in real values before running:
#   cd scaffold && docker compose -f docker-compose.dev.yml up -d --build
#
# Never commit the real .env. This file exists because a literal
# SESSION_SECRET and a permanently-on DEV_LOGIN were both committed to
# docker-compose.dev.yml and confirmed as real security findings — anyone
# holding that secret could forge a session for any user or child, with
# escalated:true, entirely offline, and DEV_LOGIN=1 needed no credential at
# all. Docker Compose loads a .env file from this same directory
# automatically for ${VAR} substitution — no extra flag needed.

# Required. Signs every session token this stack issues (HMAC-SHA256).
# Generate a real one, don't reuse this repo's own history, and don't
# reuse it across machines:
#   openssl rand -hex 32
SESSION_SECRET=

# Opt-in only, default off. Set to 1 to enable POST /v1/auth/dev-login,
# which mints a real, fully valid session for any {userId} or {childId}
# with NO credential check at all — see server/index.mjs's own header.
# This is what physical-device testing needs; leave it 0 (or unset)
# anywhere this stack might be reachable by anyone but you.
DEV_LOGIN=0
