# OLIVE BRANCH — production secrets template for docker-compose.prod.yml.
#
# A SEPARATE file from .env.example (the dev template) on purpose — the
# whole point is that a real deployment's secrets are never the same values
# a developer's laptop uses. Copy this to .env.prod, fill in real values,
# and NEVER commit .env.prod itself (already covered by the root .gitignore
# pattern that excludes scaffold/.env — see that entry's own comment).
#
#   cp .env.prod.example .env.prod
#   # generate each secret below independently — do not reuse one value
#   # across two variables, and do not reuse any dev .env value here
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Every variable below is REQUIRED — docker-compose.prod.yml uses `:?` on
# each one, so `up` fails fast with the specific missing name rather than
# starting with a blank/default/guessable value. See that file's own header
# for why this file exists as a second, separate template rather than
# reusing .env.example's shape.

# Postgres superuser password. Only used by the `db` container itself and by
# tools/docker-dev/init-db.prod.sh at first boot (to create the two roles
# below) — the app never connects as this role. openssl rand -hex 32
POSTGRES_SUPERUSER_PASSWORD=

# app_owner — the role server/migrate actually connect as (NOSUPERUSER
# NOBYPASSRLS; see tools/docker-dev/init-db.sql's header for why that
# matters). openssl rand -hex 32
APP_OWNER_PASSWORD=

# backup_reader — the role tools/backup-db.sh / the `backup` Compose service
# connect as (BYPASSRLS, SELECT-only; see
# db/migrations/0022_backup_reader_role.sql for the full reasoning).
# openssl rand -hex 32
BACKUP_READER_PASSWORD=

# HMAC key for every issued session (packages/auth/src/auth.ts's
# issueSession/verifyAssertion). openssl rand -hex 32. MUST differ from any
# dev .env's SESSION_SECRET — anyone holding a dev secret should not thereby
# hold a valid production one.
SESSION_SECRET=

# Signs/verifies every GET /media/:key?exp=&sig= signed URL
# (server/routes.mjs's defaultMediaStorage). openssl rand -hex 32. MUST
# differ from any dev .env's MEDIA_SIGNING_SECRET, same reasoning as
# SESSION_SECRET above. Without a persisted value here, a fresh random
# secret was minted every process start — every outstanding signed URL
# silently 403'd on the next restart (a routine `restart: always` recovery,
# an OOM kill, a rolling redeploy) — a real finding this project's own
# post-tier audit caught.
MEDIA_SIGNING_SECRET=

# MASTERFILE §16.2 #6 REVERSED AGAIN — calls run on LiveKit Cloud, not
# self-hosted Jitsi. Create a project at https://cloud.livekit.io, then
# copy its WebSocket URL and an API key/secret pair here. server/routes.mjs
# fails loudly (500 call_backend_unconfigured) rather than silently if any
# of the three is unset — there is no public-server fallback the way the
# old JITSI_SERVER_URL briefly had one, on purpose: a misconfigured prod
# deploy should fail a real call attempt immediately, not degrade onto
# infrastructure nobody chose. tools/jitsi-selfhost/ and its own real
# address are left documented, not deleted, per §21.7 — see that
# directory's own README for the now-superseded self-hosted path.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. Database name inside the `db` container. Defaults to olive_prod
# if unset.
#POSTGRES_DB_NAME=olive_prod

# Optional. Which pre-built image tag server/migrate/callroom run — see
# docker-compose.prod.yml's own note #7 on why this should be a specific,
# deliberately-built tag from CI (see .github/workflows/ — publishing that
# tag automatically is disclosed as its own, honestly out-of-scope gap in
# this same pass; that workflow file explains what's missing and why),
# rather than defaulting to whatever `docker build` produces locally.
#IMAGE_REPO=olive-branch
#IMAGE_TAG=latest

# Optional. Host ports, if 5434/8123/8787 are already taken on this host.
#DB_HOST_PORT=5434
#SERVER_HOST_PORT=8123
#CALLROOM_HOST_PORT=8787

# Optional. Where `--profile ops run --rm backup` writes dumps on the host.
# See scaffold/docs/backup-and-restore.md.
#BACKUP_DIR=./backups
