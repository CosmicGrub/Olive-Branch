# Olive VPS kit environment template. bootstrap.sh copies this to
# /opt/olive/.env (chmod 600) and fills the empty values with freshly
# generated random secrets ON THE SERVER. Never commit a filled-in copy.

# Public name clients use. bootstrap.sh sets <ip-with-dashes>.sslip.io from
# the server's public IP; replace with your own domain when you have one.
PUBLIC_HOST=


POSTGRES_DB_NAME=olive
POSTGRES_SUPERUSER_PASSWORD=
APP_OWNER_PASSWORD=
BACKUP_READER_PASSWORD=
SESSION_SECRET=
MEDIA_SIGNING_SECRET=

# Optional off-box copy of the (already age-encrypted) backups, for example
# BACKUP_RCLONE_REMOTE=mybucket:olive-backups . Empty = off.
BACKUP_RCLONE_REMOTE=
